# No API keys are required for the currently connected public providers.
# Optional: set the permanent public origin for metadata and social sharing.
# MUBBLE_SITE_URL=https://your-domain.example

# Optional: select an existing system Chromium for browser tests/screenshots.
# MUBBLE_CHROMIUM_PATH=/usr/bin/chromium

# Optional: target an already running server during browser verification.
# MUBBLE_TEST_URL=http://127.0.0.1:3000
